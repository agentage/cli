{
  "name": "@agentage/cli",
  "version": "0.38.1",
  "description": "The agentage CLI - connect this machine to agentage from the terminal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentage": "./dist/cli.js"
  },
  "author": "Volodymyr Vreshch",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/agentage/cli/issues"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit && tsc -p fixtures",
    "lint": "eslint src e2e fixtures",
    "lint:fix": "eslint src e2e fixtures --fix",
    "format": "prettier --write \"{src,e2e}/**/*.ts\" \"fixtures/**/*.{js,json}\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.ts\" \"fixtures/**/*.{js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "type-check:e2e": "tsc -p e2e",
    "clean": "rm -rf dist *.tsbuildinfo coverage playwright-report test-results",
    "verify": "npm run type-check && npm run type-check:e2e && npm run lint && npm run format:check && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "prettier": "latest",
    "typescript": "6.0.3",
    "vitest": "latest"
  },
  "keywords": [
    "cli",
    "agentage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentage/cli.git"
  },
  "homepage": "https://agentage.io",
  "license": "MIT"
}
