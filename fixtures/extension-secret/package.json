{
  "name": "@agentage/fixture-secret",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "agentage": {
    "id": "secret",
    "configuration": {
      "token": {
        "type": "string",
        "secret": true,
        "description": "API token the secret fixture reads"
      },
      "access": {
        "type": "string",
        "enum": [
          "read",
          "write"
        ],
        "default": "read",
        "description": "What the token may do"
      }
    }
  }
}
